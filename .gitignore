# NEVER commit ROMs, discs, or extracted game assets. Project rule, carried
# over from the PS1 repo. Discs live in ../shared/Roms and OpenPete keeps its
# own copy in its library.
*.bin
*.cue
*.iso
*.img

# OpenPete build output. Source mods are compiled by OpenPete at startup into
# its own library folder, not here, but a local build drops these.
*.dll
*.o
*.obj
*.exe

# Per-machine settings the engine writes back from the Mods panel. The schema
# lives in mod.toml and IS tracked; the committed values are not.
config.toml

# Private working notes: correspondence and anything not ours to publish.
# The repository is public; this directory is not.
docs/private/

# macOS metadata, in case anything is ever copied from the laptop again.
.DS_Store
._*

# OpenPete compiles the mod in place and drops its artifacts here.
.build/
